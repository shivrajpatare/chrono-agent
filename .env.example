# Groq API Configuration (Required for agent execution)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
PRIMARY_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
FALLBACK_MODEL=llama-3.3-70b-versatile
FAST_BACKUP_MODEL=openai/gpt-oss-20b

# Search Configuration (Optional Tavily API key; falls back cleanly to DDGS if empty)
TAVILY_API_KEY=

# Application & Storage Settings
TIMEZONE=Asia/Kolkata
DATABASE_PATH=data/chrono.db

